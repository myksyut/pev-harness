{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_017SNFQi35bAnkjNboDfcGon","type":"tool_result","content":"1\timport { describe, it, expect, vi, beforeEach } from 'vitest';\n2\timport {\n3\t  STORAGE_KEY,\n4\t  loadSubmissions,\n5\t  saveSubmission,\n6\t  submitWithDelay,\n7\t  buildSubmitHandler,\n8\t} from '../src/form.js';\n9\t\n10\tfunction createMockStorage() {\n11\t  const map = new Map();\n12\t  return {\n13\t    getItem: (k) => (map.has(k) ? map.get(k) : null),\n14\t    setItem: (k, v) => map.set(k, v),\n15\t    removeItem: (k) => map.delete(k),\n16\t    clear: () => map.clear(),\n17\t    _map: map,\n18\t  };\n19\t}\n20\t\n21\tdescribe('loadSubmissions', () => {\n22\t  it('未保存 state は [] を返す', () => {\n23\t    const storage = createMockStorage();\n24\t    expect(loadSubmissions(storage)).toEqual([]);\n25\t  });\n26\t\n27\t  it('JSON parse 失敗時は [] を返す (例: 不正な文字列が紛れ込んでも crash しない)', () => {\n28\t    const storage = createMockStorage();\n29\t    storage.setItem(STORAGE_KEY, 'not json');\n30\t    expect(loadSubmissions(storage)).toEqual([]);\n31\t  });\n32\t\n33\t  it('object (array でない) が入っていても [] にフォールバック', () => {\n34\t    const storage = createMockStorage();\n35\t    storage.setItem(STORAGE_KEY, JSON.stringify({ unexpected: true }));\n36\t    expect(loadSubmissions(storage)).toEqual([]);\n37\t  });\n38\t});\n39\t\n40\tdescribe('saveSubmission', () => {\n41\t  it('submittedAt を付与して append 保存される', () => {\n42\t    const storage = createMockStorage();\n43\t    const before = Date.now();\n44\t    const entry = saveSubmission(storage, { name: 'A', email: 'a@b.c' });\n45\t    expect(entry.name).toBe('A');\n46\t    expect(entry.submittedAt).toBeDefined();\n47\t    expect(new Date(entry.submittedAt).getTime()).toBeGreaterThanOrEqual(before);\n48\t\n49\t    const all = loadSubmissions(storage);\n50\t    expect(all).toHaveLength(1);\n51\t    expect(all[0].email).toBe('a@b.c');\n52\t  });\n53\t\n54\t  it('複数 submission は順序を保って append される', () => {\n55\t    const storage = createMockStorage();\n56\t    saveSubmission(storage, { name: 'A' });\n57\t    saveSubmission(storage, { name: 'B' });\n58\t    saveSubmission(storage, { name: 'C' });\n59\t    expect(loadSubmissions(storage).map((s) => s.name)).toEqual(['A', 'B', 'C']);\n60\t  });\n61\t});\n62\t\n63\tdescribe('submitWithDelay', () => {\n64\t  it('delayMs 後に save される', async () => {\n65\t    vi.useFakeTimers();\n66\t    const storage = createMockStorage();\n67\t    const promise = submitWithDelay(storage, { name: 'A' }, 100);\n68\t    expect(loadSubmissions(storage)).toEqual([]);\n69\t    await vi.advanceTimersByTimeAsync(100);\n70\t    await promise;\n71\t    expect(loadSubmissions(storage)).toHaveLength(1);\n72\t    vi.useRealTimers();\n73\t  });\n74\t});\n75\t\n76\tdescribe('buildSubmitHandler', () => {\n77\t  const valid = {\n78\t    name: '山田',\n79\t    email: 'y@example.com',\n80\t    phone: '',\n81\t    plan: 'standard',\n82\t    agreement: true,\n83\t  };\n84\t\n85\t  function makeContext(overrides = {}) {\n86\t    const setErrors = vi.fn();\n87\t    const setSubmitting = vi.fn();\n88\t    const onSuccess = vi.fn();\n89\t    const storage = createMockStorage();\n90\t    const getFormData = vi.fn(() => valid);\n91\t    const handler = buildSubmitHandler({\n92\t      getFormData,\n93\t      setErrors,\n94\t      setSubmitting,\n95\t      onSuccess,\n96\t      storage,\n97\t      delayMs: 0,\n98\t      ...overrides,\n99\t    });\n100\t    return { handler, setErrors, setSubmitting, onSuccess, storage, getFormData };\n101\t  }\n102\t\n103\t  it('正常 submit: validation pass → saveSubmission → onSuccess', async () => {\n104\t    const ctx = makeContext();\n105\t    const ev = { preventDefault: vi.fn() };\n106\t    await ctx.handler(ev);\n107\t    expect(ev.preventDefault).toHaveBeenCalled();\n108\t    expect(ctx.setErrors).toHaveBeenCalledWith(expect.objectContaining({ name: null, email: null }));\n109\t    expect(ctx.setSubmitting).toHaveBeenNthCalledWith(1, true);\n110\t    expect(ctx.setSubmitting).toHaveBeenNthCalledWith(2, false);\n111\t    expect(ctx.onSuccess).toHaveBeenCalledOnce();\n112\t    expect(loadSubmissions(ctx.storage)).toHaveLength(1);\n113\t  });\n114\t\n115\t  it('validation 失敗時は save も onSuccess も呼ばれない', async () => {\n116\t    const ctx = makeContext({ getFormData: () => ({ ...valid, email: 'bad' }) });\n117\t    await ctx.handler({ preventDefault: () => {} });\n118\t    expect(ctx.onSuccess).not.toHaveBeenCalled();\n119\t    expect(ctx.setSubmitting).not.toHaveBeenCalled();\n120\t    expect(loadSubmissions(ctx.storage)).toHaveLength(0);\n121\t  });\n122\t\n123\t  it('二重送信防止: submit 中の再 invoke は無視', async () => {\n124\t    const ctx = makeContext({ delayMs: 50 });\n125\t    vi.useFakeTimers();\n126\t    const ev1 = { preventDefault: vi.fn() };\n127\t    const ev2 = { preventDefault: vi.fn() };\n128\t    const p1 = ctx.handler(ev1);\n129\t    const p2 = ctx.handler(ev2); // 即座に再 click\n130\t    await vi.advanceTimersByTimeAsync(50);\n131\t    await Promise.all([p1, p2]);\n132\t    expect(ctx.onSuccess).toHaveBeenCalledOnce();\n133\t    expect(loadSubmissions(ctx.storage)).toHaveLength(1);\n134\t    vi.useRealTimers();\n135\t  });\n136\t});\n137\t"}]},"parent_tool_use_id":"toolu_01NQ2oZGnXFraztjtu31pAoX","session_id":"eb6133e0-a8e9-419b-879d-26cf595b230a","uuid":"8a89e219-a0eb-49f4-af23-f906d3421bfe","timestamp":"2026-06-09T06:18:07.166Z","subagent_type":"pev-harness:verifier","task_description":"Verify validateAge implementation"}
