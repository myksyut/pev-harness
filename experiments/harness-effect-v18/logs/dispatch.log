{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_014AbwHmXVqbsMAYdV1FYght","type":"tool_result","content":"1\t// Event signup form — validation 純関数群\n2\t//\n3\t// 各 validator は (value) => string | null の signature。\n4\t// null = OK、 string = error message (日本語、 UI にそのまま表示)。\n5\t// validation.js は副作用なし。 DOM/Storage には触れない。\n6\t\n7\tconst PLAN_VALUES = ['standard', 'premium', 'student'];\n8\t\n9\texport function validateName(value) {\n10\t  const trimmed = (value ?? '').trim();\n11\t  if (trimmed.length === 0) return '氏名は必須です';\n12\t  if (trimmed.length > 50) return '氏名は50文字以内で入力してください';\n13\t  return null;\n14\t}\n15\t\n16\texport function validateEmail(value) {\n17\t  const trimmed = (value ?? '').trim();\n18\t  if (trimmed.length === 0) return 'メールアドレスは必須です';\n19\t  const pattern = /^[^\\s@]+@[^\\s@]+\\.[^\\s@]+$/;\n20\t  if (!pattern.test(trimmed)) return 'メールアドレスの形式が正しくありません';\n21\t  return null;\n22\t}\n23\t\n24\t// 任意項目。 入力があればフォーマット検証する。\n25\t// 日本の電話番号: ハイフンあり/なし両対応、 数字のみ 10 or 11 桁。\n26\texport function validatePhone(value) {\n27\t  const trimmed = (value ?? '').trim();\n28\t  if (trimmed.length === 0) return null;\n29\t  const digits = trimmed.replace(/-/g, '');\n30\t  if (!/^\\d{10,11}$/.test(digits)) return '電話番号は10桁または11桁の数字で入力してください';\n31\t  return null;\n32\t}\n33\t\n34\texport function validatePlan(value) {\n35\t  if (!PLAN_VALUES.includes(value)) return 'プランを選択してください';\n36\t  return null;\n37\t}\n38\t\n39\texport function validateAgreement(checked) {\n40\t  if (!checked) return '利用規約への同意が必要です';\n41\t  return null;\n42\t}\n43\t\n44\texport function validateForm(data) {\n45\t  return {\n46\t    name: validateName(data.name),\n47\t    email: validateEmail(data.email),\n48\t    phone: validatePhone(data.phone),\n49\t    plan: validatePlan(data.plan),\n50\t    agreement: validateAgreement(data.agreement),\n51\t  };\n52\t}\n53\t\n54\texport function hasErrors(errors) {\n55\t  return Object.values(errors).some((e) => e !== null);\n56\t}\n57\t\n58\texport const PLANS = PLAN_VALUES;\n59\t"}]},"parent_tool_use_id":null,"session_id":"eb6133e0-a8e9-419b-879d-26cf595b230a","uuid":"b346a74f-1472-481f-9796-32fed3224726","timestamp":"2026-06-09T06:16:03.543Z","tool_use_result":{"type":"text","file":{"filePath":"/private/tmp/v4-dispatch/src/validation.js","content":"// Event signup form — validation 純関数群\n//\n// 各 validator は (value) => string | null の signature。\n// null = OK、 string = error message (日本語、 UI にそのまま表示)。\n// validation.js は副作用なし。 DOM/Storage には触れない。\n\nconst PLAN_VALUES = ['standard', 'premium', 'student'];\n\nexport function validateName(value) {\n  const trimmed = (value ?? '').trim();\n  if (trimmed.length === 0) return '氏名は必須です';\n  if (trimmed.length > 50) return '氏名は50文字以内で入力してください';\n  return null;\n}\n\nexport function validateEmail(value) {\n  const trimmed = (value ?? '').trim();\n  if (trimmed.length === 0) return 'メールアドレスは必須です';\n  const pattern = /^[^\\s@]+@[^\\s@]+\\.[^\\s@]+$/;\n  if (!pattern.test(trimmed)) return 'メールアドレスの形式が正しくありません';\n  return null;\n}\n\n// 任意項目。 入力があればフォーマット検証する。\n// 日本の電話番号: ハイフンあり/なし両対応、 数字のみ 10 or 11 桁。\nexport function validatePhone(value) {\n  const trimmed = (value ?? '').trim();\n  if (trimmed.length === 0) return null;\n  const digits = trimmed.replace(/-/g, '');\n  if (!/^\\d{10,11}$/.test(digits)) return '電話番号は10桁または11桁の数字で入力してください';\n  return null;\n}\n\nexport function validatePlan(value) {\n  if (!PLAN_VALUES.includes(value)) return 'プランを選択してください';\n  return null;\n}\n\nexport function validateAgreement(checked) {\n  if (!checked) return '利用規約への同意が必要です';\n  return null;\n}\n\nexport function validateForm(data) {\n  return {\n    name: validateName(data.name),\n    email: validateEmail(data.email),\n    phone: validatePhone(data.phone),\n    plan: validatePlan(data.plan),\n    agreement: validateAgreement(data.agreement),\n  };\n}\n\nexport function hasErrors(errors) {\n  return Object.values(errors).some((e) => e !== null);\n}\n\nexport const PLANS = PLAN_VALUES;\n","numLines":59,"startLine":1,"totalLines":59}}}
